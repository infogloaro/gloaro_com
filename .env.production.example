# Production frontend build configuration.
# Copy to .env / .env.production and fill in real values.
#
# IMPORTANT: Any variable prefixed with VITE_ is inlined into the public JS
# bundle at build time. Never put secrets here.

# Backend API base URL (must match the backend routes, which are mounted under /api/v1)
VITE_API_BASE_URL=https://api.gloaro.com/api/v1

# Razorpay key ID is a publishable key (safe to expose to the browser)
VITE_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
# WhatsApp form notifications (UltraMsg). Server-only: NO VITE_ prefix.
# Set these in Vercel → Project → Settings → Environment Variables.
ULTRAMSG_INSTANCE=instanceXXXXXX
ULTRAMSG_TOKEN=xxxxxxxxxxxxxxxx
ULTRAMSG_TO=+91XXXXXXXXXX
