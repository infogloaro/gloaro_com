{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowListFrontendBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::gloaro-frontend"
    },
    {
      "Sid": "AllowFrontendObjectSync",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::gloaro-frontend/*"
    },
    {
      "Sid": "AllowCloudFrontInvalidation",
      "Effect": "Allow",
      "Action": "cloudfront:CreateInvalidation",
      "Resource": "arn:aws:cloudfront::799061513393:distribution/<CLOUDFRONT_DISTRIBUTION_ID>"
    }
  ]
}
